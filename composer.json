{
	"name": "chrxdigital/social-card-studio",
	"description": "Generates a custom, branded share image (og:image) for posts, custom post types and the homepage.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Chris Rwakabubu",
			"homepage": "https://wp-fundi.com"
		}
	],
	"require": {
		"php": ">=8.1",
		"woocommerce/action-scheduler": "^3.9"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"phpstan/extension-installer": "^1.3",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"ChrxDigital\\SocialCardStudio\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ChrxDigital\\SocialCardStudio\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	},
	"scripts-descriptions": {
		"lint": "Run PHPCS against WordPress-Extra and WordPress-Docs.",
		"lint:fix": "Apply the automatically fixable PHPCS violations.",
		"analyse": "Run PHPStan at level 6.",
		"test": "Run the PHPUnit suite.",
		"check": "Run lint, analyse and test in sequence."
	}
}
