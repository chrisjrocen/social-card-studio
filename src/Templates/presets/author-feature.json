{
	"schema": 1,
	"id": "author-feature",
	"version": 1,
	"canvas": {
		"w": 1200,
		"h": 630,
		"bg": "#111827"
	},
	"safe_area": {
		"top": 48,
		"right": 56,
		"bottom": 48,
		"left": 56
	},
	"layers": [
		{
			"type": "gradient",
			"id": "ground",
			"box": {
				"x": 0,
				"y": 0,
				"w": 1200,
				"h": 630
			},
			"angle": 0,
			"stops": [
				{
					"at": 0.0,
					"color": "#111827FF"
				},
				{
					"at": 1.0,
					"color": "#1F2937FF"
				}
			]
		},
		{
			"type": "shape",
			"id": "tint",
			"shape": "rect",
			"fill": "{{brand_accent}}",
			"box": {
				"x": 0,
				"y": 0,
				"w": 6,
				"h": 630
			},
			"stroke": "",
			"stroke_width": 0,
			"radius": 0,
			"opacity": 1.0
		},
		{
			"type": "image",
			"id": "avatar",
			"source": "{{author_avatar}}",
			"fit": "cover",
			"shape": "circle",
			"box": {
				"x": 76,
				"y": 170,
				"w": 160,
				"h": 160
			},
			"radius": 0,
			"opacity": 1.0,
			"effects": {
				"blur": 0,
				"grayscale": false,
				"tint": ""
			},
			"fallback": ""
		},
		{
			"type": "text",
			"id": "author",
			"content": "{{author_name}}",
			"box": {
				"x": 56,
				"y": 360,
				"w": 200,
				"h": 30
			},
			"font": {
				"role": "body",
				"weight": 600,
				"family": ""
			},
			"size": {
				"min": 15,
				"max": 21,
				"autofit": true
			},
			"line_height": 1.2,
			"tracking": 0.0,
			"align": "center",
			"vertical_align": "top",
			"max_lines": 1,
			"overflow": "ellipsis",
			"color": "#F9FAFB",
			"transform": "none"
		},
		{
			"type": "text",
			"id": "byline",
			"content": "{{author_role|primary_term}}",
			"box": {
				"x": 56,
				"y": 396,
				"w": 200,
				"h": 44
			},
			"font": {
				"role": "body",
				"weight": 400,
				"family": ""
			},
			"size": {
				"min": 12,
				"max": 15,
				"autofit": true
			},
			"line_height": 1.3,
			"tracking": 0.0,
			"align": "center",
			"vertical_align": "top",
			"max_lines": 2,
			"overflow": "ellipsis",
			"color": "#9CA3AF",
			"transform": "none"
		},
		{
			"type": "text",
			"id": "headline",
			"content": "{{share_headline|title}}",
			"box": {
				"x": 330,
				"y": 150,
				"w": 814,
				"h": 240
			},
			"font": {
				"role": "heading",
				"weight": 700,
				"family": ""
			},
			"size": {
				"min": 28,
				"max": 56,
				"autofit": true
			},
			"line_height": 1.12,
			"tracking": -0.01,
			"align": "right",
			"vertical_align": "middle",
			"max_lines": 3,
			"overflow": "ellipsis",
			"color": "#FFFFFF",
			"transform": "none",
			"shadow": {
				"x": 0,
				"y": 2,
				"blur": 8,
				"color": "#00000059"
			}
		},
		{
			"type": "text",
			"id": "meta",
			"content": "{{reading_time}} · {{site_name}}",
			"box": {
				"x": 330,
				"y": 420,
				"w": 814,
				"h": 26
			},
			"font": {
				"role": "body",
				"weight": 400,
				"family": ""
			},
			"size": {
				"min": 14,
				"max": 18,
				"autofit": true
			},
			"line_height": 1.2,
			"tracking": 0.0,
			"align": "right",
			"vertical_align": "top",
			"max_lines": 1,
			"overflow": "ellipsis",
			"color": "#9CA3AF",
			"transform": "none"
		}
	]
}
