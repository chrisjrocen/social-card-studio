				"h": 40
			},
			"font": {
				"role": "body",
				"weight": 600,
				"family": ""
			},
			"size": {
				"min": 15,
				"max": 20,
				"autofit": true
			},
			"line_height": 1.2,
			"tracking": 0.1,
			"align": "right",
			"vertical_align": "bottom",
			"max_lines": 1,
			"overflow": "ellipsis",
			"color": "#FFFFFFCC",
			"transform": "uppercase"
