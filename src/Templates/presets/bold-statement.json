{
	"schema": 1,
	"id": "bold-statement",
	"version": 1,
	"canvas": {
		"w": 1200,
		"h": 630,
		"bg": "#2563EB"
	},
	"safe_area": {
		"top": 48,
		"right": 56,
		"bottom": 48,
		"left": 56
	},
	"layers": [
		{
			"type": "shape",
			"id": "field",
			"shape": "rect",
