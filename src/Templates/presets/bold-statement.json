				"h": 630
			},
			"stroke": "",
			"stroke_width": 0,
			"radius": 0,
			"opacity": 1.0
		},
		{
			"type": "gradient",
			"id": "depth",
			"box": {
				"x": 0,
				"y": 0,
				"w": 1200,
				"h": 630
			},
			"angle": 90,
			"stops": [
				{
					"at": 0.0,
					"color": "#00000000"
				},
				{
					"at": 1.0,
					"color": "#00000040"
				}
			]
		},
		{
			"type": "text",
			"id": "headline",
