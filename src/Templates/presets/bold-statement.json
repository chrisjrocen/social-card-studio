		{
			"type": "shape",
			"id": "rule",
			"shape": "rect",
			"fill": "#FFFFFF66",
			"box": {
				"x": 1060,
				"y": 560,
				"w": 84,
				"h": 3
			},
			"stroke": "",
			"stroke_width": 0,
			"radius": 0,
			"opacity": 1.0
